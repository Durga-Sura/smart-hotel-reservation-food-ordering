# Replace before running. Never commit .env.
DB_PASSWORD=replace-with-a-long-random-database-password
# Optional: seed the Fern hotel and a first owner. Minimum 12-character password.
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD=replace-with-a-long-random-owner-password
# Set true when deployed behind HTTPS. Keep false for http://localhost.
COOKIE_SECURE=false
